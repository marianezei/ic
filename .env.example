# Copie para .env e ajuste. O .env real não vai para o git.

# Imagem do banco (PostgreSQL + PostGIS + TimescaleDB). Fixar uma tag exata antes do deploy.
TIMESCALE_TAG=pg17

POSTGRES_USER=hub
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=hub_clima
POSTGRES_PORT=5432

# Raiz dos dados brutos e padronizados (bronze/prata), fora do git.
DATA_DIR=./data
